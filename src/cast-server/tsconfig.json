{
    "compilerOptions": {
        "baseUrl": "../..",
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "paths": {
            "/@/main/*": ["src/main/*"],
            "/@/shared/*": ["src/shared/*"]
        },
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "target": "esnext"
    }
}
